# Copy to .env and fill in for local development.
# In CI/Azure, these are supplied via GitHub Secrets / Key Vault instead.

# --- Wazuh ---
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=change-me
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=change-me

# --- Azure ---
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_RESOURCE_GROUP=rg-soc-ai-dev
AZURE_ML_WORKSPACE=mlw-soc-ai-dev
AZURE_STORAGE_ACCOUNT=
AZURE_KEY_VAULT_NAME=

# --- LLM ---
BASE_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.2
FINE_TUNED_ADAPTER_PATH=./ml/models/soc-lora-adapter
LLM_INFERENCE_URL=http://localhost:8001
LLM_MAX_NEW_TOKENS=512

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
