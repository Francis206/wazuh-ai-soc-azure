# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
!docker/wazuh/config/**/*.example

# Terraform
infra/**/.terraform/
