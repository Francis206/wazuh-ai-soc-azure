<!--
  Custom rules marking alerts eligible for LLM triage. CORRECTED.

  THE BUG: rule 100010 required <field name="ml_pipeline_eligible">true</field>.
  Nothing in the repo ever produces that field - no decoder, no agent config,
  no code in src/. So 100010 never fired. 100020 is if_matched_sid 100010 and
  100030 is if_matched_sid 100020, so the entire chain was dead.

  Consequence: no alert ever carried ml_pipeline_tier2 or ml_pipeline_tier3,
  so tier_from_wazuh_groups() always returned TIER_1 and SocOrchestrator never
  routed to Tier 2 or Tier 3 by rule group. The Tier 1/2/3 routing the whole
  architecture rests on was inert.

  THE FIX: gate on rule level, which Wazuh already computes, instead of a
  field nobody sets. Level 7 matches MIN_RULE_LEVEL in
  wazuh/integrations/ml_pipeline_integration.py, so the SIEM and the
  forwarder now agree on what "eligible" means - previously they did not
  even use the same criterion.

  ALSO FIXED: 100030 used <if_matched_sid> with no frequency/timeframe, which
  is not a valid composite correlation rule. It now has both, plus a field to
  correlate on, which is what "correlated multi-stage activity" requires.

  INSTALL - this matters, see report P0-5. Wazuh reads etc/rules/*.xml and
  does NOT recurse into subdirectories. The committed compose file mounted
  the directory at /var/ossec/etc/rules/custom/, where Wazuh never looks.
  Mount the FILE:

      - ./wazuh/rules/local_ml_rules.xml:/var/ossec/etc/rules/local_ml_rules.xml:ro

  And the rules do nothing until the alert is forwarded - see
  patches/ossec-conf-snippet.xml for the <integration> block that is also
  missing.
-->
<group name="local,ml_pipeline,">

  <!-- Base tag. level 0 generates no alert of its own, it only groups. -->
  <rule id="100000" level="0">
    <if_group>syslog|sshd|web|firewall|windows|authentication_failed|attacks</if_group>
    <description>Base group for ML-pipeline-eligible events</description>
  </rule>

  <!--
    Tier 1. Gates on level >= 7 rather than a field nothing sets.

    no_full_log is deliberately REMOVED. The committed rule set it, which
    strips full_log from the alert - and full_log is the field
    build_triage_prompt() interpolates as "Raw log:". The model would have
    received "Raw log: n/a" for every alert it was asked to triage.
    If you keep no_full_log for storage reasons, change the prompt builder
    to use a field that survives.
  -->
  <rule id="100010" level="7">
    <if_sid>100000</if_sid>
    <description>Event flagged for AI-augmented SOC triage (Tier 1)</description>
    <group>ml_pipeline_tier1,</group>
  </rule>

  <!-- Tier 2: repeated events from one source inside a window. -->
  <rule id="100020" level="12" frequency="5" timeframe="300">
    <if_matched_sid>100010</if_matched_sid>
    <same_source_ip />
    <description>Repeated high-severity events from same source: escalate to Tier 2</description>
    <group>ml_pipeline_tier2,</group>
  </rule>

  <!--
    Tier 3: the same source hitting several distinct rules across a longer
    window - i.e. multi-stage, not just repetition of one thing.
    different_srcip is what distinguishes this from 100020; the committed
    version had no correlation predicate at all, so "correlated multi-stage
    activity" was asserted by the description and by nothing else.
  -->
  <rule id="100030" level="15" frequency="3" timeframe="1800">
    <if_matched_sid>100020</if_matched_sid>
    <same_source_ip />
    <description>Correlated multi-stage activity: candidate for automated Tier 3 response</description>
    <group>ml_pipeline_tier3,</group>
  </rule>

  <!--
    Suppression. Without this, the pipeline pays for LLM triage on its own
    health checks and on the noisiest recurring rules in any estate. At
    roughly 3 LLM calls per escalated alert this is a real line item.
    Extend the list from your own top-20 alert counts before go-live.
  -->
  <rule id="100040" level="0">
    <if_sid>100010</if_sid>
    <field name="agent.name">^soc-api$|^ml-inference$</field>
    <description>Suppress: alerts from the SOC automation stack itself</description>
  </rule>

</group>
